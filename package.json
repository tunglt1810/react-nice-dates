{
  "name": "@tunglt91/react-nice-dates",
  "version": "3.1.6",
  "main": "build/index.js",
  "module": "build/index.esm.js",
  "unpkg": "build/index.umd.js",
  "author": "Hernán Sartorio",
  "license": "MIT",
  "types": "index.d.ts",
  "packageManager": "bun@1.4.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tunglt1810/react-nice-dates.git"
  },
  "bugs": {
    "url": "https://github.com/tunglt1810/react-nice-dates/issues"
  },
  "homepage": "https://github.com/tunglt1810/react-nice-dates#readme",
  "files": [
    "build",
    "src/style.scss",
    "index.d.ts"
  ],
  "scripts": {
    "start": "parcel website/index.html --dist-dir tmp",
    "build": "rollup -c && sass src/style.scss build/style.css --no-source-map && postcss build/style.css --use autoprefixer -o build/style.css",
    "build:website": "rm -rf build-website/* && parcel build website/index.html --dist-dir build-website --no-content-hash && cp website/CNAME build-website/CNAME",
    "deploy": "gh-pages -d build-website",
    "lint": "eslint --cache src test website",
    "release": "bun run build && bun publish --access public",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "date-fns": "^2.0.0 || ^3.0.0 || ^4.0.0",
    "prop-types": "^15",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@parcel/transformer-sass": "^2.16.4",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "autoprefixer": "^10.6.1",
    "date-fns": "^4.4.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "neostandard": "^0.13.0",
    "parcel": "^2.16.4",
    "postcss": "^8.5.28",
    "postcss-cli": "^12.0.0",
    "prism-react-renderer": "^2.4.1",
    "prop-types": "^15.8.1",
    "react": "^19",
    "react-dom": "^19",
    "rollup": "^4.63.5",
    "sass": "^1.105.0"
  },
  "dependencies": {
    "classnames": "^2.5.1"
  },
  "jest": {
    "testEnvironment": "jsdom"
  },
  "targets": {
    "main": false,
    "module": false,
    "types": false
  }
}
